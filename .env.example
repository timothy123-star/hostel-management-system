PORT=4000
NODE_ENV=development
JWT_SECRET=demo-secret-key-for-development-change-in-production-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
DATABASE_FILE=./hostel.sqlite

# WhatsApp Meta Cloud API Configuration (Leave blank for SIMULATOR mode)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=1491681220684722
META_WHATSAPP_BUSINESS_ACCOUNT_ID=28905530469140919
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=hostel_meta_verify_token_demo_2026
META_GRAPH_API_VERSION=v21.0
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
PHOTO_STORAGE_DIR=./private-uploads/student-photos

# QR public verification base (absolute https reachable URL used inside QR payload).
# Must be https and externally reachable; localhost/127.0.0.1 never allowed in QR.
QR_VERIFICATION_PUBLIC_BASE_URL=https://your-public-domain

# QR token encryption (AES-256-GCM). Generate locally and keep secret; never commit.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_TOKEN_ENCRYPTION_KEY=

# Approved WhatsApp Utility template names (create in Meta Business Manager first)
WA_TEMPLATE_PAYMENT_APPROVED=hostelos_payment_approved
WA_TEMPLATE_PAYMENT_REJECTED=hostelos_payment_rejected
WA_TEMPLATE_PHOTO_APPROVED=hostelos_photo_approved
WA_TEMPLATE_PHOTO_REJECTED=hostelos_photo_rejected
WA_TEMPLATE_QR_ISSUED=hostelos_qr_issued

# --- Railway single-service production (set in Railway dashboard, not .env) ---
# NODE_ENV=production
# PORT is injected by Railway; do not set a fixed value.
# DATABASE_FILE=/data/hostel.sqlite
# PHOTO_STORAGE_DIR=/data/photos
# PUBLIC_BASE_URL=https://<railway-domain>
# PUBLIC_APP_URL=https://<railway-domain>
# QR_VERIFICATION_PUBLIC_BASE_URL=https://<railway-domain>
# JWT_SECRET=<min-32-chars-production-secret>
# ADMIN_USERNAME=<non-default-manager-username>
# ADMIN_PASSWORD=<min-16-chars-production-password>
# QR_TOKEN_ENCRYPTION_KEY=<base64-32-bytes>
# META_WHATSAPP_ACCESS_TOKEN=<meta-cloud-token-when-live>
# META_WHATSAPP_APP_SECRET=<meta-app-secret-for-webhook-hmac>
# META_WHATSAPP_VERIFY_TOKEN=<meta-webhook-verify-token>
